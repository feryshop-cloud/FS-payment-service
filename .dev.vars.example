# Secret shared antara worker & FS-Public untuk verifikasi signature webhook.
# Harus sama dengan PAYMENT_WEBHOOK_SECRET di FS-Public .env.local
PAYMENT_WEBHOOK_SECRET=dev-sandbox-secret-change-me

# Dev: izinkan callback_url ke localhost/private (jika FS-Public jalan lokal). Jangan set di produksi.
# ALLOW_PRIVATE_CALLBACKS=true

# Token admin untuk aksi sandbox (/v1/payments/:id/pay|fail|simulate).
# Kosong = hanya provider mock yang boleh pakai (dev). Set di produksi untuk fail-closed.
# Kirim lewat header: X-Payment-Admin-Token: <token>
# SANDBOX_ADMIN_TOKEN=

# Pakasir (dipakai saat PAYMENT_PROVIDER=pakasir)
# Buat Proyek di https://app.pakasir.com, salin Slug & Api Key.
PAKASIR_PROJECT=
PAKASIR_API_KEY=

# SumoPod (dipakai saat PAYMENT_PROVIDER=sumopod)
# API Key dari dashboard SumoPod. Webhook token/secret dari halaman Settings.
SUMODOP_API_KEY=
SUMODOP_WEBHOOK_TOKEN=
# Alternatif verifikasi webhook via Svix signature (gantikan SUMODOP_WEBHOOK_TOKEN):
# SUMODOP_WEBHOOK_SECRET=whsec_...
